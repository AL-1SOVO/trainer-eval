# ============================================================
#  复制本文件为 .env.local 并填入真实值
#  start.ps1 会自动读取；.env.local 已在 .gitignore 中，不会入库
# ============================================================

# AI 功能（主观题批改、学习助手）所需的 DeepSeek API Key
# 不填也能启动：登录/考试/阅卷/报表均可用，仅 AI 相关功能会报错
DEEPSEEK_API_KEY=sk-在这里填入你的key

# ---- MimirQ 知识库服务（可选）----
# 不填时检索走内置的本地混合检索（ngram 全文 + 子串 + RRF），功能正常。
# 填了则优先走 MimirQ（混合召回 + 重排 + 引用），不可用时自动降级并熔断。
# MIMIRQ_API_KEY 的值 = MimirQ .env 里的 DIFY_EXTERNAL_KNOWLEDGE_API_KEYS
# MIMIRQ_ENABLED=true
# MIMIRQ_BASE_URL=http://localhost:8000
# MIMIRQ_API_KEY=mimirq-xxxxxxxx

# 可选：覆盖数据库账号（默认 root / 123456，与 application.yml 的默认值一致）
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=123456
