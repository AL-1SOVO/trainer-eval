# --- 数据库数据目录（约 195MB，且含 TLS 私钥 ca-key.pem/server-key.pem）---
# 绝不能入库：含私钥 + 全部业务数据
mysql-data/

# --- 构建产物（内含泄露的明文 API key 与本地脚本）---
target/
build/
dist/

# --- 前端依赖与产物 ---
node_modules/
.vite/
*.local

# --- 密钥与本地环境变量 ---
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
*.jks

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath

# --- 日志与临时文件 ---
*.log
logs/
*.tmp
*.bak
*.orig
*.rej
~$*
*.err
*.pid

# --- 操作系统 ---
Thumbs.db
Desktop.ini
.DS_Store

# --- 上传目录（用户文件，不入库）---
uploads/
