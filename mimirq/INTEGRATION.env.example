# =============================================================================
# trainer-eval × MimirQ 集成所需的环境变量（模板，可入库）
# =============================================================================
# 用法：
#   Copy-Item .\mimirq\.env.example .\mimirq\.env      # 先以上游模板为底
#   再把下面这些键按需覆盖到 .env 里
#
# 为什么单独留这个文件：mimirq/.env 被 .gitignore 忽略（含密钥），
# 全新 clone 后不存在。集成相关的关键配置如果只存在于那台机器上，
# 换台机器就会出现"检索质量突然变差/模型下不下来"这类无法解释的现象。
# 这里只列**集成必须关心**的项，其余用上游 .env.example 的默认值。
# =============================================================================

# ---------------------------------------------------------------- 向量模型
# 关键结论：不要用 deterministic_test。
# 它是哈希向量、排序无语义，实测会让"语料里根本没有的问题"也返回高分资料，
# 助手据此编造引用。必须换成真实语义模型。
#
# 方案一（推荐，无需任何 key，本机已验证）：本地 sentence-transformers
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 说明：约 95MB、512 维、中文优化，首次使用时会自动下载。
# 想升级质量可换成 BAAI/bge-m3（约 2.2GB、1024 维、多语言），
# 但换模型后必须清空向量库并全量重推（见下）。
#
# 方案二（需要 key）：走 OpenAI 兼容的云端 embedding
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=<你的 key>
#
# 注意：EMBEDDING_DIM 不是 MimirQ 的有效配置项（维度由模型自身决定），写了也没用。

# ---------------------------------------------------------------- 模型下载
# 上游默认指向国内镜像；实测该镜像在部分网络下**主页可达但文件下载失败**
# （表现为 LocalEntryNotFoundError，很难看懂）。这里指向官方站点。
HF_ENDPOINT=https://huggingface.co
# 把模型缓存放进 upload_data 卷：默认的 /app/.cache 在容器可写层，
# 容器一重建（docker compose up --build）模型就丢了，会重新下载。
HF_HOME=/data/uploads/hf_cache
# 关键：模型已在本地缓存后，必须显式禁止联网。
# 否则每次冷加载都会去 HuggingFace 校验，网络慢时进入重试，
# 单次检索被拖到几十秒（实测 92 秒），期间向量客户端因超时被关闭，
# MimirQ 返回 503 → Java 侧读超时判失败 → 熔断 → 界面显示"当前为降级检索"。
# 修复前后实测：首次检索 18786ms → 2856ms；网络重试 14 次 → 0 次；模型加载 8 次 → 1 次。
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ---------------------------------------------------------------- Dify 兼容检索
DIFY_EXTERNAL_KNOWLEDGE_ENABLED=true
DIFY_EXTERNAL_KNOWLEDGE_API_KEYS=mimirq-xxxxxxxx
DIFY_EXTERNAL_KNOWLEDGE_TENANT_ID=00000000-0000-0000-0000-000000000000
# 必须是**真实存在的用户 ID**：Dify 兼容层会校验租户成员身份，
# 用 "system:dify" 之类的占位值会得到 403 Not a tenant member。
# 取 MimirQ 管理员登录响应里的 user.id。
DIFY_EXTERNAL_KNOWLEDGE_ACCOUNT_ID=<管理员 user_id>
# knowledge_id → dataset UUID 的映射。dataset 名与 trainer-eval 的
# mimirq.knowledge-id-pattern 对齐（course-{courseId}），写入侧会自动建库。
DIFY_EXTERNAL_KNOWLEDGE_MAP_JSON={"course-1":{"dataset_ids":["<dataset-uuid>"]}}

# ---------------------------------------------------------------- 换模型后的必做步骤
# 1) 清空旧向量库（Chroma 集合维度固定，旧维度的向量会让新维度插不进去）
#      docker compose -f .\docker\docker-compose.lite.yml stop mimirq-api mimirq-worker
#      docker run --rm -v mimirq_vector_data:/v alpine sh -c 'rm -rf /v/*'
#      docker compose -f .\docker\docker-compose.lite.yml up -d
# 2) 让 Java 侧全量重推（触发重新向量化 + 重建文档）
#      POST /api/v1/rag/knowledge-base/resync
# 3) 巡检服务端事实与本地期望是否一致
#      GET  /api/v1/rag/knowledge-base/status
# 4) 重跑 golden 评测，与上一轮对比
#      POST /api/v1/rag/eval
